# ACE Framework — environment configuration
# Copy this file to .env and edit as needed
# (The framework reads from environment variables, not .env directly —
#  source this file with: source .env  or  set -a && source .env && set +a)

# LLM provider: mock | openai | ollama
# Default: mock (runs fully offline, no API key required)
ACE_LLM_PROVIDER=mock

# OpenAI-compatible API (used when ACE_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Ollama local server (used when ACE_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Storage
ACE_DATA_DIR=data

# Deduplication similarity threshold (0.0–1.0)
ACE_SIMILARITY_THRESHOLD=0.85

# Maximum bullets in the playbook before pruning
ACE_MAX_BULLETS=200

# Logging level: DEBUG | INFO | WARNING | ERROR
ACE_LOG_LEVEL=INFO
