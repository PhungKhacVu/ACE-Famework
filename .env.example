# LLM provider: "mock" | "openai" | "ollama"
ACE_LLM_PROVIDER=mock

# OpenAI settings (used when ACE_LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Ollama settings (used when ACE_LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Playbook storage path
ACE_PLAYBOOK_PATH=data/playbook.json

# Similarity threshold for deduplication (0.0-1.0)
ACE_SIM_THRESHOLD=0.85

# Logging level: DEBUG | INFO | WARNING | ERROR
ACE_LOG_LEVEL=INFO
